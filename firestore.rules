rules_version = '2';

// Reglas para Operación Baeza.
// Desde que se activó Firebase Authentication (login anónimo, sin email ni contraseña:
// cada dispositivo recibe un identificador anónimo estable la primera vez que abre la app
// con conexión), exigimos "request.auth != null" para leer o escribir. Esto NO ata los
// datos a un usuario/UID concreto — sigue siendo el "código de acceso" el que identifica
// tu planning — pero sí bloquea que alguien llame directamente a la API REST de Firestore
// sin pasar antes por la app (que es quien hace el login anónimo). Es una capa extra, no
// sustituye al PIN de la app ni a una autenticación real por usuario.
//
// Lo que arreglan estas reglas:
//   1) Solo se puede leer/escribir dentro de la colección "plannings", y solo si la
//      petición viene de un cliente autenticado (aunque sea de forma anónima).
//   2) Se bloquea el "list" del documento principal (nadie puede pedir "dame todos los
//      documentos de plannings" y enumerar los códigos de acceso de otras personas); solo
//      se puede hacer "get" de un documento si ya conoces su ID exacto (tu código de acceso).
//   3) Cualquier otra colección/ruta queda denegada por completo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /plannings/{accessCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
