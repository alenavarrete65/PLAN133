rules_version = '2';

// Reglas para Operación Baeza.
// Desde que se activó Firebase Authentication de verdad (correo/contraseña, con aprobación
// manual por parte del administrador), solo puede leer o escribir en "plannings" quien tenga
// una sesión iniciada Y cuya cuenta esté aprobada. Antes de esto, cualquiera con el enlace y
// login anónimo podía leer/escribir cualquier código de acceso que adivinara; ahora, además,
// hace falta tener una cuenta aprobada por el administrador.
//
// Cada cuenta tiene su propio planning, aislado de las demás: el ID del documento en
// "plannings" es el uid de la cuenta (accessCode == request.auth.uid). Una cuenta aprobada
// solo puede leer y escribir en su propio documento (o un administrador, en cualquiera, para
// labores de mantenimiento). El antiguo sistema de código de acceso compartido ya se migró
// por completo a este modelo por cuenta, así que ya no hace falta (ni se permite) que una
// cuenta lea el planning de otra por su ID aunque lo conozca.
//
// Lo que arreglan estas reglas:
//   1) Solo se puede leer/escribir dentro de "plannings", y solo si la cuenta que hace la
//      petición está aprobada (users/{uid}.aprobado == true).
//   2) Se bloquea el "list" del documento principal (nadie puede pedir "dame todos los
//      documentos de plannings" y enumerar los uids de otras personas).
//   3) Solo se puede LEER o ESCRIBIR en el documento cuyo ID es tu propio uid (o, para labores
//      de mantenimiento, si eres administrador). Así cada cuenta tiene su propio calendario
//      totalmente aislado del de cualquier otra.
//   4) users/{uid} guarda el perfil de cada cuenta: email, si está aprobada ("aprobado") y si
//      es la cuenta administradora ("esAdmin"). Nadie puede auto-aprobarse ni auto-nombrarse
//      administrador desde la app: esos campos solo los puede cambiar quien YA es admin. La
//      única excepción es "emailVerificado": cada cuenta puede actualizar ÚNICAMENTE ese
//      campo suyo (para que el administrador vea si ya confirmó su correo antes de
//      aprobarla), sin poder tocar ningún otro campo del documento.
//   5) La subcolección plannings/{uid}/history guarda copias automáticas diarias de tus
//      datos; tiene exactamente las mismas restricciones que el documento principal (solo tu
//      propia cuenta, o un administrador).
//   6) Cualquier otra colección/ruta queda denegada por completo.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.esAdmin == true;
    }
    function estaAprobado() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aprobado == true;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.aprobado == false
        && request.resource.data.esAdmin == false;
      allow update: if esAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        // Solo se permite tocar el campo "emailVerificado", y nada más (ni aprobado, ni
        // esAdmin, ni el email): así una cuenta no puede aprobarse ni ascenderse a sí misma
        // aunque intente colar cambios junto con este campo.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerificado'])
      );
      allow delete: if esAdmin();
    }

    match /plannings/{accessCode} {
      // Solo tu propio documento (ID == tu uid), o un administrador. Ni "get" ni "list" de
      // documentos ajenos: nadie puede leer ni descubrir el planning de otra cuenta.
      allow get: if estaAprobado() && (accessCode == request.auth.uid || esAdmin());
      allow list: if false;
      allow write: if estaAprobado() && (accessCode == request.auth.uid || esAdmin());

      // Copias automáticas diarias del planning (ver maybeSnapshotHistory en index.html).
      // Mismas reglas que el documento principal: solo tu propia cuenta (o admin), nunca
      // enumerable ni accesible por nadie más.
      match /history/{day} {
        allow read, write, delete: if estaAprobado() && (accessCode == request.auth.uid || esAdmin());
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
